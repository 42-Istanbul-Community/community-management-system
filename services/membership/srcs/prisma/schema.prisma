generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
    member
    moderator
    admin

    @@map("member_role")
}

enum RequestStatus {
    pending
    approved
    rejected

    @@map("request_status")
}

model community_members {
    id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    community_id String        @db.Uuid
    user_id      String        @db.Uuid
    role         MemberRole    @default(member)
    joined_at    DateTime      @default(now()) @db.Timestamptz

    @@unique([community_id, user_id])
}

model moderator_permissions {
    id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    community_id String   @db.Uuid
    permission   Json     @db.JsonB
    
    @@unique([community_id, permission])
}

model community_join_requests {
    id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    community_id String        @db.Uuid
    user_id      String        @db.Uuid
    message      String?       @db.VarChar(256)
    status       RequestStatus @default(pending)
    created_at   DateTime      @default(now()) @db.Timestamptz
    reviewed_at  DateTime?     @db.Timestamptz
    reviewed_by  String?       @db.Uuid

    @@unique([community_id, user_id])
}