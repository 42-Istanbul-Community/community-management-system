generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CommunityStatus {
  active
  inactive

  @@map("community_status")
}

enum CommunityVisibility {
  public
  private

  @@map("community_visibility")
}

enum CommunityAccess {
  open
  restricted
  closed

  @@map("community_access")
}

enum RequestStatus {
  pending
  approved
  rejected

  @@map("request_status")
}

model communities {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String                @db.VarChar(128)
  slug        String                @unique @db.VarChar(128)
  rules_path  String?               @db.VarChar(256)
  description String?
  status      CommunityStatus       @default(active)
  visibility  CommunityVisibility   @default(public)
  access      CommunityAccess       @default(open)
  created_at  DateTime              @default(now()) @db.Timestamptz
  tags        community_tags[]
}

model tags {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @unique @db.VarChar(64)
  communities community_tags[]
}

model community_tags {
  communityId String      @map("community_id") @db.Uuid
  tagId       String      @map("tag_id") @db.Uuid
  community   communities @relation(fields: [communityId], references: [id], onDelete: Cascade)
  tag         tags        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([communityId, tagId])
}

model community_create_requests {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @db.VarChar(128)
  status      RequestStatus @default(pending)
  user_id     String        @db.Uuid
  created_at  DateTime      @default(now()) @db.Timestamptz
  rules_path  String?       @db.VarChar(256)
  description String?
  message     String?
  reviewed_by String?       @db.Uuid
  reviewed_at DateTime?     @db.Timestamptz
}