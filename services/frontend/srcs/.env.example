# Set to 'development' to log API calls in the console.
VITE_ENVIRONMENT=

# API Gateway Address.
VITE_API_URL=https://api.localhost:8443

# 42 OAuth application UID.
VITE_42_CLIENT_ID=

# Must match the redirect URI registered on intra.42.fr exactly.
VITE_42_REDIRECT_URI=https://api.localhost:8443/orchestration/42/callback

# Google OAuth client id.
VITE_GOOGLE_CLIENT_ID=

# Must match the redirect URI registered in Google Cloud Console exactly.
VITE_GOOGLE_REDIRECT_URI=https://api.localhost:8443/orchestration/google/callback