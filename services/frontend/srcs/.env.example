# Vite dev sunucusu /api isteklerini gateway'e yönlendirir.
VITE_API_URL=/api

# 42 OAuth uygulamasının UID'si.
# intra.42.fr → Settings → API → REGISTER A NEW APP adımından alınır.
VITE_42_CLIENT_ID=

# 42 uygulamasında kayıtlı redirect adresiyle birebir aynı olmalıdır.
VITE_42_REDIRECT_URI=https://api.localhost:3443/orchestration/42/callback