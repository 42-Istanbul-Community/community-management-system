# API gateway adresi. İstekler doğrudan buraya gider. → CORS ile
VITE_API_URL=https://api.localhost:8443

# 42 OAuth uygulamasının UID'si.
# intra.42.fr → Settings → API → REGISTER A NEW APP adımından alınır.
VITE_42_CLIENT_ID=

# 42 uygulamasında kayıtlı redirect adresiyle birebir aynı olmalıdır.
VITE_42_REDIRECT_URI=https://api.localhost:8443/orchestration/42/callback